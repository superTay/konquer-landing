---
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '../styles/global.css';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import { getImage } from 'astro:assets';
import christianFoto from '../assets/christian-fundador.jpg';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
}

const {
  title = "KonquerAI · Tu oficina administrativa, montada | La construcción y los oficios de reformas",
  description = "Te montamos un equipo administrativo que trabaja para ti: presupuestos, facturas, cobros y tus números al día. Para autónomos y pymes de la construcción y los oficios de reformas. Sin aprender tecnología.",
  noindex = false,
  ogTitle = "KonquerAI · Un equipo administrativo trabajando para ti",
  ogDescription = "Orden, control, tiempo y tranquilidad para autónomos y pymes de la construcción. Te lo dejamos montado y te acompañamos.",
  ogImage = "https://www.konquerai.com/og-image.png",
  ogImageAlt = "KonquerAI — Tu oficina administrativa, montada",
  ogType = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://www.konquerai.com").href;

// Foto del fundador para el nodo Person del schema (URL absoluta y optimizada).
const founderImage = await getImage({ src: christianFoto, width: 800, format: "jpg" });
const founderImageUrl = new URL(founderImage.src, Astro.site ?? "https://www.konquerai.com").href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Verificación de buscadores -->
    <meta name="msvalidate.01" content="03438030CF712F11EBC711787FAF21CA" />
    <meta name="google-site-verification" content="w0T7YcAOuuxkrM1x0M0L0-VD5xV1T5QFFyZyim8r5d8" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="KonquerAI" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    {ogImage === "https://www.konquerai.com/og-image.png" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Extras por página (JSON-LD de posts, etc.) -->
    <slot name="head" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts: Outfit + Plus Jakarta Sans — self-hosted via @fontsource (imports en el frontmatter) -->

    <!-- Estilos globales importados en el frontmatter (procesados por Tailwind v4) -->

    <!-- Schema.org — grafo de entidad (Organization + Person + WebSite + SoftwareApplication).
         sameAs Organization: Wikidata + Crunchbase. Person: LinkedIn personal.
         Pendiente de añadir cuando existan: página de empresa en LinkedIn y Google Business Profile. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.konquerai.com/#organization",
          "name": "KonquerAI",
          "legalName": "Christian Marzal Della-Rovere",
          "url": "https://www.konquerai.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://www.konquerai.com/og-image.png",
            "width": 1200,
            "height": 630
          },
          "image": "https://www.konquerai.com/og-image.png",
          "description": "Montamos y acompañamos la oficina administrativa digital de autónomos y pymes de la construcción y los oficios de reformas: presupuestos, facturas, cobros y números al día.",
          "email": "info@konquerai.com",
          "foundingDate": "2026",
          "areaServed": { "@type": "Country", "name": "España" },
          "knowsLanguage": "es-ES",
          "founder": { "@id": "https://www.konquerai.com/#founder" },
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "info@konquerai.com",
            "contactType": "atención al cliente",
            "availableLanguage": "Spanish",
            "areaServed": "ES"
          },
          "sameAs": [
            "https://www.linkedin.com/company/konquerai/",
            "https://www.crunchbase.com/organization/konquerai",
            "https://apps.apple.com/es/app/konquerai/id6767595664",
            "https://play.google.com/store/apps/details?id=com.konquerai.mobile"
          ]
        },
        {
          "@type": "Person",
          "@id": "https://www.konquerai.com/#founder",
          "name": "Christian Marzal Della-Rovere",
          "jobTitle": "Fundador",
          "description": "Fundador de KonquerAI. Formado en gestión y administración de empresas, trabaja en desarrollo e inteligencia artificial aplicada a la administración de pequeños negocios. Hijo de pintor autónomo.",
          "image": founderImageUrl,
          "url": "https://www.konquerai.com/sobre-nosotros/",
          "knowsAbout": [
            "Administración de pequeñas empresas de reformas",
            "Verifactu",
            "IVA en reformas",
            "Inteligencia artificial aplicada a la gestión de negocios"
          ],
          "worksFor": { "@id": "https://www.konquerai.com/#organization" },
          "sameAs": [
            "https://www.linkedin.com/in/christian-marzal-della-rovere-3455073a7/"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://www.konquerai.com/#website",
          "url": "https://www.konquerai.com",
          "name": "KonquerAI",
          "description": "Tu oficina administrativa, montada y acompañada. Para la construcción y los oficios de reformas.",
          "inLanguage": "es-ES",
          "publisher": { "@id": "https://www.konquerai.com/#organization" }
        },
        {
          "@type": "Service",
          "@id": "https://www.konquerai.com/#service",
          "name": "Oficina administrativa digital KonquerAI",
          "serviceType": "Implantación y acompañamiento de oficina administrativa digital",
          "url": "https://www.konquerai.com",
          "inLanguage": "es-ES",
          "areaServed": { "@type": "Country", "name": "España" },
          "audience": {
            "@type": "BusinessAudience",
            "audienceType": "Autónomos y pymes de la construcción y los oficios de reformas"
          },
          "description": "Un equipo de empleados digitales que hace presupuestos, ordena compras y facturas y lleva la caja, montado y acompañado durante el primer mes. Complementa al gestor, no lo sustituye.",
          "provider": { "@id": "https://www.konquerai.com/#organization" }
        }
      ]
    })} />
  </head>
  <body class="bg-white text-ink antialiased">
    <!-- Sentinel para condensar la navbar al hacer scroll (sin listener de scroll) -->
    <div id="nav-sentinel" aria-hidden="true"></div>
    <slot />

    <!-- Contacto directo por WhatsApp -->
    <WhatsAppBubble />

    <!-- IntersectionObserver fallback for scroll animations (Firefox) -->
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reducedMotion && !CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      }
    </script>

    <!-- Microinteracciones: spotlight en tarjetas + botones magnéticos -->
    <script>
      const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Spotlight: la luz sigue al cursor sobre las tarjetas
      document.querySelectorAll<HTMLElement>('.pilar-card, .oferta-card, .card-spotlight').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          card.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });

      // Botones magnéticos (solo con ratón y sin reduced-motion)
      if (!rm && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('.btn-primary, .btn-white').forEach((btn) => {
          btn.addEventListener('mousemove', (e) => {
            const r = btn.getBoundingClientRect();
            const mx = e.clientX - r.left - r.width / 2;
            const my = e.clientY - r.top - r.height / 2;
            btn.style.transform = 'translate(' + (mx * 0.18) + 'px,' + (my * 0.28) + 'px)';
          });
          btn.addEventListener('mouseleave', () => { btn.style.transform = ''; });
        });
      }
    </script>

    <!-- Contadores animados (cuentan al entrar en viewport; respeta reduced-motion) -->
    <script>
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (counters.length) {
        const reduceCounters = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const animateCounter = (el: HTMLElement) => {
          const target = parseFloat(el.dataset.counter ?? '0');
          const suffix = el.dataset.suffix ?? '';
          const prefix = el.dataset.prefix ?? '';
          if (reduceCounters) { el.textContent = prefix + target + suffix; return; }
          const duration = 1400;
          const start = performance.now();
          const frame = (now: number) => {
            const p = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = prefix + Math.floor(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(frame);
            else el.textContent = prefix + target + suffix;
          };
          requestAnimationFrame(frame);
        };
        if (!('IntersectionObserver' in window)) {
          counters.forEach(animateCounter);
        } else {
          const cObs = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateCounter(entry.target as HTMLElement);
                cObs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.4 });
          counters.forEach((c) => cObs.observe(c));
        }
      }
    </script>

    <!-- Navbar flotante: se condensa al salir del top (sin listener de scroll) -->
    <script>
      const headerEl = document.getElementById('header');
      const sentinel = document.getElementById('nav-sentinel');
      if (headerEl && sentinel) {
        const navObs = new IntersectionObserver(([entry]) => {
          headerEl.classList.toggle('is-scrolled', !entry.isIntersecting);
        }, { threshold: 0 });
        navObs.observe(sentinel);
      }
    </script>


    <style>
      #nav-sentinel {
        position: absolute;
        top: 0;
        left: 0;
        width: 1px;
        height: 56px;
        pointer-events: none;
      }
    </style>
  </body>
</html>
