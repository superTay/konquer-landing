---
/**
 * index.astro — Home de KonquerAI (borrador de copy, posicionamiento de octubre 2026).
 * Fuente del mensaje: iAmasters OS › konquerai/01-estrategia y 02-venta, y posts de LinkedIn.
 * Recorrido: equipo → dolor → qué vendemos → tu equipo en 30 días → caso real → gestor →
 * tres caminos → preguntas → contacto. Sin precios: se dan en la llamada.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/home/Hero.astro";
import Problema from "../components/home/Problema.astro";
import LoQueVendemos from "../components/home/LoQueVendemos.astro";
import Equipo from "../components/home/Equipo.astro";
import CasoReal from "../components/home/CasoReal.astro";
import Gestor from "../components/home/Gestor.astro";
import TresCaminos from "../components/home/TresCaminos.astro";
import Preguntas from "../components/home/Preguntas.astro";
import Contacto from "../components/home/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Header />
  <main>
    <Hero />
    <Problema />
    <LoQueVendemos />
    <Equipo />
    <CasoReal />
    <Gestor />
    <TresCaminos />
    <Preguntas />
    <Contacto />
  </main>
  <Footer />
</Base>
