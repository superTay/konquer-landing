---
/** LeadCtaBand.astro — Banda slim de captación (LEAD).
 *  Va después de la Comparativa, justo cuando el visitante se ha visto reflejado.
 *  CTA a WhatsApp (contacto directo, baja fricción) en vez de a /precios,
 *  para no repetir el mismo destino que Hero/Oferta/Pricing/CtaFinal. */
const WHATSAPP_NUMBER = "34654041704";
const MESSAGE = "Hola, ¿cuánto tiempo y dinero me puede ahorrar KonquerAI?";
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(MESSAGE)}`;
---
<section class="section-padding lead-band">
  <div class="container-narrow lead-band-inner reveal">
    <p class="lead-band-text">¿Cuánto te cuesta a ti el papeleo? Resérvate una demo y te lo enseñamos en vivo.</p>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-white lead-band-cta">Escríbenos por WhatsApp</a>
  </div>
</section>

<style>
  .lead-band { background: var(--color-ink); }
  .lead-band-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .lead-band-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .lead-band-text {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.3;
    max-width: 28ch;
  }
  .lead-band-cta { flex: none; }
</style>
