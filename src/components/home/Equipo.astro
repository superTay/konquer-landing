---
/**
 * Equipo — la analogía de los empleados digitales + la puesta en marcha en 30 días.
 * Fuente: analogia-equipo-administrativo.md.
 * LucIA: captura REAL de la app (datos de demostración) dentro de un móvil con fichas flotantes.
 * Pendiente (sesión de diseño): sustituir avatares por ilustraciones/animación.
 */
import { Image } from "astro:assets";
import luciaApp from "../../assets/screenshots/lucia-app.png";

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/equipo/{sofia,matias,maria}.{jpg,jpeg,png,webp}",
  { eager: true },
);
const foto = (slug: string) => {
  const key = Object.keys(fotos).find((k) => k.split("/").pop()?.startsWith(slug + "."));
  return key ? fotos[key].default : null;
};

const semanas = [
  { cuando: "Semana 1", name: "SofIA", area: "Clientes y presupuestos", texto: "Le dictas el presupuesto desde la obra y en unos minutos lo tienes listo para enviar.", tone: "orange", slug: "sofia", chips: ["Clientes", "Presupuestos"], alt: "SofIA, tu empleada de clientes y presupuestos" },
  { cuando: "Semana 2", name: "MatIAs", area: "Facturas y compras", texto: "Las facturas de proveedor se colocan solas y te avisa si un albarán no cuadra. Y tus facturas las emites desde la obra, con el móvil, listas para Verifactu.", tone: "teal", slug: "matias", chips: ["Facturas", "Proveedores", "Albaranes"], alt: "MatIAs, tu empleado de facturas y compras" },
  { cuando: "Semana 3", name: "MarIA", area: "Tu caja", texto: "Sabes quién te debe y qué toca pagar, y ves venir la caja de las próximas semanas.", tone: "ink", slug: "maria", chips: ["Cobros", "Pagos", "Previsión de caja"], alt: "MarIA, tu empleada de tesorería" },
];
---

<section class="equipo" id="equipo">
  <div class="container-narrow equipo-inner">
    <div class="equipo-intro">
      <h2 class="equipo-h2 reveal">Antes, esto solo podían pagarlo las grandes empresas.</h2>
      <p class="equipo-lead reveal">
        Un contable, una secretaria, alguien que lleve las cuentas. Hasta hace nada, tener un equipo
        así exigía sueldos, despacho y mucho presupuesto. Hoy lo puede tener cualquier autónomo, con
        un poco de orden. Y dedicando menos horas, no más.
      </p>
    </div>

    <div class="equipo-plan">
      <div class="equipo-plan-head reveal">
        <h3>Tu equipo, funcionando en 30 días</h3>
        <p>
          No tienes que aprender nada. Te lo dejamos montado y cada semana solo te pedimos dos o tres
          cosas. Lo demás lo hace tu equipo.
        </p>
      </div>

      <ol class="timeline">
        {semanas.map((s) => ({ ...s, img: foto(s.slug) })).map((s) => (
          <li class={`timeline-step tone-${s.tone} reveal`}>
            <span class="timeline-when">{s.cuando}</span>
            <span class="timeline-avatar" aria-hidden="true">{s.name.charAt(0)}</span>
            <h4 class="timeline-name">{s.name} <span>· {s.area}</span></h4>
            <p class="timeline-text">{s.texto}</p>
            <figure class="person">
              {s.img ? (
                <Image src={s.img} alt={s.alt} widths={[320, 480, 640]} sizes="(min-width: 900px) 360px, 80vw" loading="lazy" class="person-img" />
              ) : (
                <span class="person-ph" aria-hidden="true"></span>
              )}
              <figcaption class="person-label">
                <strong>{s.name}</strong>
                <span class="person-chips">
                  {s.chips.map((c) => <span class="person-chip">{c}</span>)}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </div>

    <div class="lucia reveal">
      <div class="lucia-copy">
        <h3 class="lucia-h3">LucIA conoce tu negocio casi mejor que tú. Pregúntale lo que quieras.</h3>
        <p>
          Está conectada con todo el equipo y tiene acceso a toda la información de tu negocio. A
          cualquier hora y desde donde estés, le preguntas lo que quieras y te lo dice al momento.
        </p>
        <p class="lucia-note">
          Son asistentes de inteligencia artificial, pero no tienes que saber nada de eso. Les hablas
          y te entienden.
        </p>
      </div>

      <figure class="stage" aria-label="Conversación real con LucIA en la app">
        <div class="stage-glow" aria-hidden="true"></div>

        <div class="phone">
          <div class="phone-screen">
            <Image
              src={luciaApp}
              alt="La app de KonquerAI: LucIA responde a «¿Quién me debe?» con 28.941,28 € en 6 facturas"
              widths={[360, 540, 720]}
              sizes="(min-width: 900px) 300px, 70vw"
              loading="lazy"
              class="phone-img"
            />
          </div>
          <span class="phone-island" aria-hidden="true"></span>
        </div>

        <div class="chip chip-debt" aria-hidden="true">
          <span class="chip-arrow">↓</span>
          <span class="chip-text">
            <span class="chip-label">Te deben</span>
            <strong>28.941,28 €</strong>
          </span>
        </div>

        <div class="chip chip-ring" aria-hidden="true">
          <svg viewBox="0 0 36 36" class="ring">
            <circle cx="18" cy="18" r="14" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="5" />
            <circle cx="18" cy="18" r="14" fill="none" stroke="var(--color-teal)" stroke-width="5" stroke-linecap="round" stroke-dasharray="66 88" transform="rotate(-90 18 18)" />
          </svg>
          <span class="chip-text">
            <strong>6 facturas</strong>
            <span class="chip-label">por cobrar</span>
          </span>
        </div>

        <figcaption class="stage-caption">Captura real de la app, con datos de demostración</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .equipo {
    background: #fff;
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .equipo-inner {
    max-width: 1180px;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .equipo-intro {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 960px) {
    .equipo-intro { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: end; }
  }

  .equipo-h2 {
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .equipo-lead {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-slate);
  }

  .equipo-plan-head h3 {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    letter-spacing: -0.015em;
  }

  .equipo-plan-head p {
    margin-top: 0.5rem;
    color: var(--color-slate);
    max-width: 52ch;
  }

  /* ── Línea de 30 días ── */
  .timeline {
    list-style: none;
    margin-top: 2.25rem;
    display: grid;
    gap: 2rem;
    position: relative;
  }

  @media (min-width: 900px) {
    .timeline { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
    .timeline::before {
      content: "";
      position: absolute;
      top: 3.6rem;
      left: 1.5rem;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--color-orange), var(--color-teal) 50%, #2B4A52);
      opacity: 0.35;
    }
  }

  .timeline-step {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .timeline-when {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--tone-ink);
  }

  .timeline-avatar {
    position: relative;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--tone);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    box-shadow: 0 0 0 6px #fff;
    margin-block: 0.25rem 0.5rem;
  }

  .timeline-name {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .timeline-name span {
    font-weight: 500;
    color: var(--color-slate);
    font-size: 1.0625rem;
  }

  .timeline-text {
    color: var(--color-slate);
    line-height: 1.6;
    max-width: 34ch;
  }

  .tone-orange { --tone: var(--color-orange); --tone-ink: #8A4B00; }
  .tone-teal   { --tone: var(--color-teal-dark); --tone-ink: #00695C; }
  .tone-ink    { --tone: #2B4A52; --tone-ink: #2B4A52; }

  /* Foto del empleado bajo cada semana */
  .timeline-step { grid-template-rows: auto auto auto 1fr auto; }

  .person {
    position: relative;
    margin-top: 1.25rem;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    background: var(--tone);
    box-shadow: 0 24px 50px -30px rgba(11, 31, 36, 0.55);
  }

  .person-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .person-label {
    position: absolute;
    inset: auto 0.6rem 0.6rem 0.6rem;
    display: grid;
    gap: 0.35rem;
    padding: 0.7rem 0.8rem;
    border-radius: 12px;
    background: rgba(11, 31, 36, 0.58);
    backdrop-filter: blur(10px) saturate(1.3);
    -webkit-backdrop-filter: blur(10px) saturate(1.3);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .person-label strong {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    line-height: 1.1;
  }

  .person-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  .person-chip {
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-teal);
  }

  /* ── LucIA ── */
  .lucia {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border-radius: 24px;
    background: #05090a;
    color: rgba(255, 255, 255, 0.82);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .lucia { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  }

  .lucia-copy { display: grid; gap: 1rem; }

  .lucia-h3 {
    color: #fff;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lucia-copy p { line-height: 1.65; }

  .lucia-note {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.62);
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    padding-block: 1rem 0.5rem;
    isolation: isolate;
  }

  .stage-glow {
    position: absolute;
    inset: 5% 10%;
    z-index: -1;
    background:
      radial-gradient(50% 45% at 50% 40%, rgba(0, 209, 178, 0.28), transparent 70%),
      radial-gradient(35% 30% at 78% 75%, rgba(255, 138, 0, 0.12), transparent 70%);
    filter: blur(24px);
  }

  .phone {
    position: relative;
    width: min(70vw, 290px);
    padding: 9px;
    border-radius: 44px;
    background: linear-gradient(150deg, #3a4a4e 0%, #12191b 40%, #2b3a3e 100%);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.16),
      0 40px 80px -30px rgba(0, 0, 0, 0.9),
      inset 0 0 0 2px rgba(0, 0, 0, 0.6);
    transform: perspective(1200px) rotateY(-9deg) rotateX(3deg) rotateZ(1.5deg);
    transform-origin: 50% 60%;
  }

  .phone-screen {
    position: relative;
    height: clamp(460px, 62vw, 600px);
    border-radius: 36px;
    overflow: hidden;
    background: #f6f8f9;
  }

  .phone-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .phone-island {
    position: absolute;
    top: 17px;
    left: 50%;
    width: 31%;
    height: 22px;
    translate: -50% 0;
    border-radius: 999px;
    background: #05090a;
  }

  /* Fichas de cristal flotando alrededor del móvil */
  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem 0.6rem 0.7rem;
    border-radius: 16px;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .chip-text { display: grid; gap: 0.1rem; }
  .chip-label { color: rgba(255, 255, 255, 0.7); font-size: 0.75rem; }
  .chip strong { font-family: var(--font-heading); font-size: 1rem; }

  .chip-debt { top: 16%; left: -1.25rem; }
  .chip-ring { bottom: 9%; right: -1.25rem; }

  .chip-arrow {
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--color-teal);
    font-weight: 700;
    background: rgba(0, 209, 178, 0.16);
  }

  .ring { width: 2.25rem; height: 2.25rem; }

  .stage-caption {
    margin-top: 1.25rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip-debt { animation: chip-float 7s ease-in-out infinite; }
    .chip-ring { animation: chip-float 8s ease-in-out -3s infinite; }
  }

  @keyframes chip-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-9px); }
  }

  @media (max-width: 480px) {
    .chip-debt { left: -0.25rem; }
    .chip-ring { right: -0.25rem; }
  }
</style>
