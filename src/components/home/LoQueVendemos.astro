---
/** Lo que vendemos — orden, control, tiempo, tranquilidad y libertad (no una app). */
const resultados = [
  { palabra: "Orden", texto: "Todo tu negocio en un solo sitio. Ni en tu cabeza, ni en el WhatsApp, ni en carpetas y papeles por la furgoneta." },
  { palabra: "Control", texto: "Sabes qué gastas, qué ganas en cada obra y quién te debe. Hoy, no al cerrar el trimestre." },
  { palabra: "Tiempo", texto: "El papeleo lo hace tu equipo. Hasta 30 horas al mes que vuelven a ser tuyas." },
  { palabra: "Tranquilidad", texto: "Tienes un equipo detrás que te avisa y te recuerda. Y a nosotros contigo hasta que esté montado." },
  { palabra: "Libertad", texto: "Tu negocio deja de depender de tu memoria. Si un día no estás, todo sigue en su sitio." },
];
---

<section class="vendemos" id="que-hacemos">
  <div class="container-narrow vendemos-inner">
    <h2 class="vendemos-h2 reveal">
      No te vendemos una app.
      <span>Te vendemos esto.</span>
    </h2>

    <dl class="vendemos-list">
      {resultados.map((r) => (
        <div class="vendemos-row reveal">
          <dt>{r.palabra}</dt>
          <dd>{r.texto}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .vendemos {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .vendemos-inner {
    max-width: 1100px;
  }

  .vendemos-h2 {
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .vendemos-h2 span {
    display: block;
    color: var(--color-slate);
  }

  .vendemos-list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .vendemos-row {
    display: grid;
    gap: 0.25rem 2.5rem;
    padding-block: clamp(1.25rem, 2.4vw, 1.75rem);
    border-top: 1px solid var(--color-border);
  }
  .vendemos-row:last-child { border-bottom: 1px solid var(--color-border); }

  @media (min-width: 768px) {
    .vendemos-row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; }
  }

  .vendemos-row dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    transition: color 0.3s var(--ease-out-expo);
  }

  .vendemos-row dd {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-slate);
    max-width: 38ch;
  }

  .vendemos-row:hover dt { color: var(--color-teal-dark); }
</style>
