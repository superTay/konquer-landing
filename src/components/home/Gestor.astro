---
/**
 * Gestor — la objeción "eso ya me lo lleva el gestor". Cuatro diferencias concretas.
 * El gestor es aliado, nunca enemigo. IVA/IRPF = "vas acumulando", estimación de gestión.
 */
const filas = [
  {
    tema: "IVA e IRPF",
    gestor: "Descubres lo que te toca pagar al cerrar el trimestre. Y a veces te llevas un susto.",
    equipo: "Ves cuánto IVA e IRPF vas acumulando mes a mes. Nada te pilla por sorpresa.",
  },
  {
    tema: "En qué gastas",
    gestor: "Te llegan las compras y las ventas, todo junto. No sabes en qué se ha ido el dinero.",
    equipo: "Todo desglosado por categorías: material, combustible, servicios, proveedores.",
  },
  {
    tema: "Albaranes",
    gestor: "Casi nunca los lleva, así que nadie los cuadra con tus facturas.",
    equipo: "Cada albarán se cuadra con su factura, y te avisa si algo no coincide.",
  },
  {
    tema: "Tu caja",
    gestor: "Con los datos de hace tres meses no puede decirte si llegas a pagar los sueldos, si coges esa obra o si aguantas una multa.",
    equipo: "Ves la caja con semanas de adelanto. Ganar dinero no es lo mismo que tener caja, y aquí lo ves venir.",
  },
];
---

<section class="gestor" id="gestor">
  <div class="container-narrow gestor-inner">
    <h2 class="gestor-h2 reveal">«Eso ya me lo lleva el gestor.»</h2>

    <div class="gestor-body reveal">
      <p>
        Es lo que más escuchamos. Y tu gestor hace muy bien su trabajo: impuestos, modelos y cuentas
        oficiales. Pero te cuenta lo que pasó cada tres meses, todo junto, cuando ya no puedes cambiar nada.
      </p>
      <p class="gestor-mirror">Es como conducir mirando por el retrovisor.</p>
    </div>

    <div class="gestor-table reveal" data-gestor role="table" aria-label="Tu gestor frente a tu equipo">
      <div class="gestor-head" role="row">
        <span role="columnheader" class="gestor-head-topic"></span>
        <span role="columnheader" class="gestor-head-past">Con el gestor</span>
        <span role="columnheader" class="gestor-head-now">Con tu equipo</span>
      </div>
      {filas.map((f, i) => (
        <div class={`gestor-row${i === 0 ? " is-active" : ""}`} data-row role="row">
          <h3 class="gestor-topic" role="rowheader">{f.tema}</h3>
          <p class="gestor-cell is-past" role="cell">{f.gestor}</p>
          <p class="gestor-cell is-now" role="cell">{f.equipo}</p>
        </div>
      ))}
    </div>

    <p class="gestor-note reveal">
      Son datos de gestión para que decidas con tiempo. Las cifras oficiales y los modelos los sigue
      presentando tu gestor.
    </p>

    <p class="gestor-close reveal">
      No dejas de tener gestor. Dejas de ir detrás.
      <span>Empiezas a ir por delante.</span>
    </p>
  </div>
</section>

<script>
  // La fila que cruza el centro de la pantalla se enciende; el resto se atenúa un poco.
  const table = document.querySelector<HTMLElement>('[data-gestor]');
  if (table && 'IntersectionObserver' in window) {
    const rows = Array.from(table.querySelectorAll<HTMLElement>('[data-row]'));
    table.classList.add('is-enhanced');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const i = rows.indexOf(e.target as HTMLElement);
        rows.forEach((r, k) => r.classList.toggle('is-active', k === i));
      });
    }, { rootMargin: '-40% 0px -40% 0px' });
    rows.forEach((r) => io.observe(r));
  }
</script>

<style>
  .gestor {
    background: var(--color-ink);
    color: rgba(255, 255, 255, 0.82);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .gestor-inner {
    max-width: 1100px;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .gestor-h2 {
    color: #fff;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .gestor-body {
    display: grid;
    gap: 1.25rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    max-width: 46ch;
  }

  .gestor-mirror {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-orange);
    max-width: 22ch;
  }

  /* ── Tabla: gestor frente a equipo ── */
  .gestor-table {
    margin-top: 0.5rem;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .gestor-head { display: none; }

  .gestor-row {
    display: grid;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .gestor-row:first-of-type { border-top: 0; }

  .gestor-topic {
    padding: 1.1rem 1.25rem 0.25rem;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .gestor-cell {
    padding: 0.5rem 1.25rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.5;
  }

  .gestor-cell.is-past {
    color: rgba(255, 255, 255, 0.62);
  }

  .gestor-cell.is-now {
    margin-top: 0.5rem;
    padding-block: 0.9rem 1.1rem;
    background: var(--color-teal);
    color: var(--color-ink);
    font-weight: 600;
  }

  .gestor-cell.is-past::before,
  .gestor-cell.is-now::before {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .gestor-cell.is-past::before { content: "Con el gestor"; }
  .gestor-cell.is-now::before { content: "Con tu equipo"; }

  @media (min-width: 900px) {
    .gestor-head {
      display: grid;
      grid-template-columns: 0.7fr 1.15fr 1.15fr;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .gestor-head span { padding: 1rem 1.5rem; font-size: 0.875rem; }
    .gestor-head-past { color: rgba(255, 255, 255, 0.62); }
    .gestor-head-now { background: var(--color-teal); color: var(--color-ink); }

    .gestor-row {
      grid-template-columns: 0.7fr 1.15fr 1.15fr;
      align-items: stretch;
    }

    .gestor-topic { padding: 1.5rem 1.5rem; align-self: center; }
    .gestor-cell { padding: 1.5rem; align-self: center; }

    .gestor-cell.is-now {
      margin-top: 0;
      align-self: stretch;
      display: flex;
      align-items: center;
      padding-block: 1.5rem;
      border-top: 1px solid rgba(11, 31, 36, 0.14);
    }
    .gestor-row:first-of-type .gestor-cell.is-now { border-top: 0; }

    .gestor-cell.is-past::before,
    .gestor-cell.is-now::before { display: none; }
  }

  /* Fila activa: línea que se dibuja y el resto se atenúa */
  .gestor-row { position: relative; }

  .gestor-row::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 1;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out-expo);
    pointer-events: none;
  }
  .gestor-row.is-active::after { transform: scaleX(1); }

  .gestor-topic { transition: transform 0.6s var(--ease-out-expo); }

  @media (min-width: 900px) {
    .is-enhanced .gestor-row { transition: opacity 0.4s ease; }
    .is-enhanced .gestor-row:not(.is-active) { opacity: 0.45; }
    .is-enhanced .gestor-row.is-active .gestor-topic { transform: translateX(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gestor-row::after,
    .gestor-topic { transition: none; }
    .is-enhanced .gestor-row.is-active .gestor-topic { transform: none; }
  }

  .gestor-note {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.6);
    max-width: 60ch;
  }

  .gestor-close {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #fff;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 22ch;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .gestor-close span { color: var(--color-teal); }
</style>
