---
/**
 * Preguntas — acordeón de dos columnas (etiqueta a la izquierda; título y preguntas a la derecha).
 * Sin precios: el coste se explica en la llamada. Se abre una pregunta cada vez.
 */
const faqs = [
  {
    q: "¿Esto es una app o un programa de gestión?",
    a: "No. Es un servicio: te montamos la oficina, la adaptamos a tu forma de trabajar y te acompañamos. La usas desde el móvil o el ordenador, pero no tienes que configurar nada ni aprenderte un programa.",
  },
  {
    q: "¿Tengo que saber de tecnología?",
    a: "No. Si sabes mandar un audio por WhatsApp, sabes usarlo. Te lo dejamos todo montado y durante el primer mes te acompañamos semana a semana.",
  },
  {
    q: "¿Sustituye a mi gestor?",
    a: "No. Tu gestor sigue con los impuestos, los modelos y la contabilidad oficial. Tú dejas de depender de él para saber cómo va tu negocio.",
  },
  {
    q: "¿Cuánto cuesta?",
    a: "Depende de cómo trabajas y de lo que necesitas. Te lo explicamos en una llamada de 15 minutos, con números claros y sin letra pequeña. Y si vemos que no te encaja, te lo decimos.",
  },
  {
    q: "¿Para quién es?",
    a: "Para autónomos y pequeñas empresas de la construcción y los oficios de reformas, desde el que va solo hasta equipos de unas 8 personas, que hoy llevan los papeles a mano. Si ya tienes un programa de gestión que te funciona, seguramente no nos necesitas.",
  },
  {
    q: "¿Mis datos están seguros?",
    a: "Sí. Cumplimos el RGPD, tus datos están en servidores europeos y solo tú accedes a ellos. Si nos pides borrarlos, los borramos.",
  },
];
const words = "Lo que nos preguntan antes de empezar".split(" ");
---

<section class="faq" id="preguntas">
  <div class="faq-inner">
    <p class="faq-label"><span class="faq-square" aria-hidden="true"></span>Preguntas frecuentes</p>

    <div class="faq-main">
      <h2 class="faq-title" data-faq-title>
        {words.map((w, i) => (
          <Fragment><span class="faq-word" style={`--d:${i * 70}ms`}>{w}</span>{i < words.length - 1 && <span class="faq-gap">{" "}</span>}</Fragment>
        ))}
      </h2>

      <div class="faq-list">
        {faqs.map((f, i) => (
          <div class={`faq-item${i === 0 ? " is-open" : ""}`}>
            <h3 class="faq-q">
              <button
                type="button"
                class="faq-btn"
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`faq-a-${i}`}
                id={`faq-q-${i}`}
              >
                <span>{f.q}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="faq-panel" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div class="faq-panel-inner">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "es-ES",
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: [".faq-q", ".faq-panel-inner p"],
    },
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  })} />
</section>

<script>
  // Una pregunta abierta cada vez
  const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));
  items.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-btn');
    btn?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('is-open');
      items.forEach((other) => {
        other.classList.remove('is-open');
        other.querySelector('.faq-btn')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Título: las palabras suben una a una al entrar en pantalla
  const title = document.querySelector<HTMLElement>('[data-faq-title]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (title && !calm && 'IntersectionObserver' in window) {
    title.classList.add('will-reveal');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          title.classList.add('is-in');
          io.disconnect();
        }
      });
    }, { threshold: 0.3 });
    io.observe(title);
  }
</script>

<style>
  .faq {
    background: #fff;
    color: var(--color-ink);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .faq-inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 24px;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .faq-inner {
      padding-inline: 96px;
      grid-template-columns: minmax(180px, 1fr) 2.6fr;
      gap: 4rem;
    }
  }

  .faq-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    align-self: start;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .faq-square {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--color-ink);
    flex: none;
  }

  .faq-title {
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
    max-width: 16ch;
  }

  .faq-word { display: inline-block; margin-right: 0.26em; }
  /* Espacio real entre palabras para crawlers y lectores de pantalla (sin ancho visible: el hueco lo da el margin) */
  .faq-gap { font-size: 0; }

  .will-reveal .faq-word {
    opacity: 0;
    transform: translateY(15px);
  }

  .will-reveal.is-in .faq-word {
    opacity: 1;
    transform: none;
    transition: opacity 0.6s var(--ease-out-expo) var(--d), transform 0.6s var(--ease-out-expo) var(--d);
  }

  .faq-list {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px dashed #c4cbce;
  }

  .faq-item { border-bottom: 1px dashed #c4cbce; }

  .faq-q { font: inherit; }

  .faq-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.25rem, 2.2vw, 1.75rem);
    background: none;
    border: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.2vw, 1.6875rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    transition: color 0.2s ease;
  }

  .faq-btn:hover { color: var(--color-teal-dark); }

  .faq-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Icono + / − */
  .faq-icon {
    position: relative;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.125rem;
    height: 2px;
    background: currentColor;
    translate: -50% -50%;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .faq-icon::after { transform: rotate(90deg); }
  .is-open .faq-icon::after { transform: rotate(0deg); }

  /* Altura y opacidad en 400 ms */
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 0.4s var(--ease-out-expo),
      opacity 0.4s ease,
      visibility 0s linear 0.4s;
  }

  .is-open .faq-panel {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .faq-panel-inner { overflow: hidden; }

  .faq-panel p {
    padding-bottom: clamp(1.25rem, 2.2vw, 1.75rem);
    max-width: 62ch;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-slate);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel,
    .faq-icon::before,
    .faq-icon::after { transition: none; }
  }
</style>
