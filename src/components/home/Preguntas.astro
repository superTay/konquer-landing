---
/** Preguntas — las objeciones de verdad, cortas. Sin precios: se dan en la llamada. */
const faqs = [
  {
    q: "¿Esto es una app o un programa de gestión?",
    a: "No. Es un servicio: te montamos la oficina, la adaptamos a tu forma de trabajar y te acompañamos. La usas desde el móvil o el ordenador, pero no tienes que configurar nada ni aprenderte un programa.",
  },
  {
    q: "¿Tengo que saber de tecnología?",
    a: "No. Si sabes mandar un audio por WhatsApp, sabes usarlo. Te lo dejamos todo montado y durante el primer mes te acompañamos semana a semana.",
  },
  {
    q: "¿Sustituye a mi gestor?",
    a: "No. Tu gestor sigue con los impuestos, los modelos y la contabilidad oficial. Tú dejas de depender de él para saber cómo va tu negocio.",
  },
  {
    q: "¿Cuánto cuesta?",
    a: "Depende de cómo trabajas y de lo que necesitas. Te lo explicamos en una llamada de 15 minutos, con números claros y sin letra pequeña. Y si vemos que no te encaja, te lo decimos.",
  },
  {
    q: "¿Para quién es?",
    a: "Para autónomos y pequeñas empresas de construcción, reformas y oficios, desde el que va solo hasta equipos de unas 8 personas, que hoy llevan los papeles a mano. Si ya tienes un programa de gestión que te funciona, seguramente no nos necesitas.",
  },
  {
    q: "¿Mis datos están seguros?",
    a: "Sí. Cumplimos el RGPD, tus datos están en servidores europeos y solo tú accedes a ellos. Si nos pides borrarlos, los borramos.",
  },
];
---

<section class="preguntas" id="preguntas">
  <div class="container-narrow preguntas-inner">
    <h2 class="preguntas-h2 reveal">Lo que nos preguntan antes de empezar.</h2>

    <div class="preguntas-list">
      {faqs.map((f) => (
        <details class="pregunta">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "es-ES",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  })} />
</section>

<style>
  .preguntas {
    background: var(--color-mist);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .preguntas-inner {
    max-width: 1100px;
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .preguntas-inner { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; align-items: start; }
  }

  .preguntas-h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  @media (min-width: 960px) {
    .preguntas-h2 { position: sticky; top: 7rem; }
  }

  .preguntas-list {
    border-top: 1px solid var(--color-border);
  }

  .pregunta {
    border-bottom: 1px solid var(--color-border);
  }

  .pregunta summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.35rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .pregunta summary::-webkit-details-marker { display: none; }

  .pregunta summary::after {
    content: "";
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background:
      linear-gradient(var(--color-ink), var(--color-ink)) center / 10px 2px no-repeat,
      linear-gradient(var(--color-ink), var(--color-ink)) center / 2px 10px no-repeat,
      #fff;
    border: 1px solid var(--color-border);
    transition: transform 0.3s var(--ease-out-expo), background-color 0.2s ease;
  }

  .pregunta[open] summary::after { transform: rotate(45deg); }
  .pregunta summary:hover { color: var(--color-teal-dark); }

  .pregunta p {
    padding-bottom: 1.5rem;
    color: var(--color-slate);
    line-height: 1.65;
    max-width: 60ch;
  }
</style>
